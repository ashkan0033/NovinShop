@model BlogPost
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "ویرایش مقاله" : "افزودن مقاله جدید";
    var tinyKey = ViewBag.TinyMceApiKey as string ?? "no-api-key";
}
<div class="bar">
    <h2>@(isEdit ? "ویرایش مقاله" : "نوشتن مقاله جدید")</h2>
    <a class="btn" asp-action="Index">بازگشت به فهرست مقالات</a>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)" method="post" class="card form">
    <div asp-validation-summary="All" class="err" style="margin-bottom:12px"></div>

    <div class="g2">
        <div class="fg">
            <label asp-for="Title">عنوان مقاله *</label>
            <input asp-for="Title" placeholder="مثال: راهنمای جامع خرید هدفون بی‌سیم" required />
            <span asp-validation-for="Title"></span>
        </div>
        <div class="fg">
            <label asp-for="Slug">نامک (Slug — خالی = ساخت خودکار)</label>
            <input asp-for="Slug" dir="ltr" placeholder="wireless-headphones-guide" />
            <span asp-validation-for="Slug"></span>
        </div>
    </div>

    <div class="g2">
        <div class="fg">
            <label asp-for="Category">دسته‌بندی مقاله *</label>
            <input asp-for="Category" list="blogCatList" placeholder="تکنولوژی، بازی و سرگرمی، راهنمای خرید..." required />
            <datalist id="blogCatList">
                <option value="تکنولوژی" />
                <option value="صوتی و تصویری" />
                <option value="بازی و سرگرمی" />
                <option value="کتاب و سبک زندگی" />
                <option value="خانه و آشپزخانه" />
                <option value="راهنمای خرید" />
            </datalist>
        </div>
        <div class="g2">
            <div class="fg">
                <label asp-for="Icon">ایموجی / آیکون کارت</label>
                <input asp-for="Icon" placeholder="" />
            </div>
            <div class="fg">
                <label asp-for="ReadingMinutes">زمان مطالعه (دقیقه)</label>
                <input asp-for="ReadingMinutes" type="number" min="1" max="120" />
            </div>
        </div>
    </div>

    <div class="fg">
        <label asp-for="Gradient">تم رنگی کاور کارت (گرادیان CSS)</label>
        <select asp-for="Gradient">
            <option value="linear-gradient(135deg,#1e3a8a,#0f172a)">آبی سرمه‌ای تکنولوژی</option>
            <option value="linear-gradient(135deg,#4c1d95,#1e1b4b)">بنفش تیره مدرن</option>
            <option value="linear-gradient(135deg,#064e3b,#022c22)">سبز زمردی گیمینگ</option>
            <option value="linear-gradient(135deg,#78350f,#451a03)">قهوه‌ای گرم کتاب و کافه</option>
            <option value="linear-gradient(135deg,#9d174d,#4c0519)">زرشکی تیره لایف‌استایل</option>
            <option value="linear-gradient(135deg,#334155,#0f172a)">خاکستری تیتانیومی</option>
        </select>
    </div>

    <div class="fg">
        <label asp-for="Summary">خلاصه مقاله (نمایش در کارت و بالای مطلب)</label>
        <textarea asp-for="Summary" rows="2" data-max="350"></textarea>
    </div>

    <div class="fg">
        <label asp-for="Content">متن کامل مقاله (HTML)</label>
        <textarea asp-for="Content" id="BlogContentEditor" rows="14"></textarea>
    </div>

    <div class="fg">
        <label class="chk">
            <input asp-for="IsPublished" />
            <span>انتشار مقاله در وبلاگ فروشگاه</span>
        </label>
    </div>

    <div style="display:flex;gap:10px">
        <button class="btn pri" type="submit">ذخیره مقاله</button>
        <a class="btn" asp-action="Index">انصراف</a>
    </div>
</form>

@section Scripts {
<script src="https://cdn.tiny.cloud/1/@tinyKey/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
<script>
    if (window.tinymce) {
        tinymce.init({
            selector: '#BlogContentEditor',
            language: 'fa',
            directionality: 'rtl',
            height: 460,
            menubar: false,
            plugins: 'lists link image table code fullscreen',
            toolbar: 'undo redo | blocks | bold italic underline | alignright aligncenter alignleft | bullist numlist | link table | code fullscreen'
        });
    }
</script>
}
