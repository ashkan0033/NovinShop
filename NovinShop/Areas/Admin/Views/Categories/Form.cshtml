@model Category
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "دسته‌بندی جدید" : "ویرایش دسته‌بندی";
}
<div class="bar"><h2>@ViewData["Title"]</h2><a class="btn" asp-action="Index">بازگشت</a></div>
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="err"></div>
    <div class="card">
        <h3 class="sec">اطلاعات اصلی</h3>
        <div class="g2">
            <div class="fg"><label asp-for="Name">نام دسته‌بندی</label><input asp-for="Name" /><span asp-validation-for="Name"></span></div>
            <div class="fg"><label asp-for="SortOrder">ترتیب نمایش</label><input asp-for="SortOrder" /><span asp-validation-for="SortOrder"></span></div>
            <div class="fg"><label asp-for="Icon">آیکن (اختیاری — یک ایموجی کوتاه)</label><input asp-for="Icon" maxlength="8" /><span asp-validation-for="Icon"></span></div>
        </div>
        <div class="fg"><label asp-for="Description">توضیحات</label><textarea asp-for="Description" rows="3"></textarea><span asp-validation-for="Description"></span></div>
        <label class="chk"><input asp-for="IsActive" /> فعال (نمایش در سایت)</label>
    </div>
    <div class="card">
        <h3 class="sec">سئو</h3>
        <div class="fg"><label asp-for="Slug">آدرس صفحه (slug)</label><input asp-for="Slug" dir="ltr" />
            <span class="hint">خالی بگذارید تا از روی نام خودکار ساخته شود</span><span asp-validation-for="Slug"></span></div>
        <div class="fg"><label asp-for="SeoTitle">عنوان سئو</label><input asp-for="SeoTitle" data-max="70" /><span asp-validation-for="SeoTitle"></span></div>
        <div class="fg"><label asp-for="SeoDescription">توضیحات سئو</label><textarea asp-for="SeoDescription" rows="2" data-max="170"></textarea><span asp-validation-for="SeoDescription"></span></div>
    </div>
    <button class="btn pri" type="submit">ذخیره</button>
</form>
